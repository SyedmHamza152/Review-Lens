# =============================================================================
# AdPilot AI — environment template.  Copy to backend/.env and fill in.
#   Windows PowerShell:  Copy-Item .env.example backend\.env
# NEVER commit the filled .env file.
# =============================================================================

# --- YouTube Data API v3 (public research: search, video/channel stats) ------
# Google Cloud Console → APIs & Services → Enable "YouTube Data API v3" → API key
YOUTUBE_API_KEY=

# --- Google OAuth 2.0 client (desktop or web application) ---------------------
# Google Cloud Console → Credentials → OAuth client ID
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Google Ads API reporting --------------------------------------------------
# 1) Developer token: https://ads.google.com/aw/apicenter → request Basic access
# 2) Complete the OAuth flow (button in Settings) OR paste a refresh token
# 3) Customer id of the account holding YouTube video campaigns (digits only ok)
GOOGLE_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
OAUTH_REDIRECT_URI=http://localhost:8321/api/v1/oauth/google/callback

# --- Core ----------------------------------------------------------------------
# SQLite default (auto-created). PostgreSQL example:
#   postgresql+psycopg://adpilot:adpilot@localhost:5432/adpilot
SQLALCHEMY_DATABASE_URL=sqlite:///data/adpilot.db
SECRET_KEY=change-me-to-a-long-random-string
DEFAULT_CURRENCY=PKR
DEFAULT_MARKET=PK
LOG_LEVEL=INFO

# Background work: inline (default, zero deps) | celery (needs Redis)
TASK_QUEUE=inline

# --- Local LLM (optional). Unreachable Ollama falls back to the rule engine. ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
